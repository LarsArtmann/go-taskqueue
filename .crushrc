permissions allow view ls grep glob edit write bash

# PreToolUse hook fleet (scripts/hooks/, --self-test pins both): converts
# this repo's recurring session-shell/gate-death classes into instant
# denies-with-fix or one-line advisories. $CRUSH_PROJECT_DIR expands at
# hook-fire time so the path works from any bash working_dir.
hook add PreToolUse --matcher '^bash$' --command 'bash "$CRUSH_PROJECT_DIR/scripts/hooks/tq-bash-guard.sh"' --name tq-bash-guard --timeout 10
hook add PreToolUse --matcher '^(edit|write|multiedit)$' --command 'bash "$CRUSH_PROJECT_DIR/scripts/hooks/tq-edit-advice.sh"' --name tq-edit-advice --timeout 5
# Deny-log side-channel (T6/H4): tq-bash-guard appends `ts|rule|cmd` rows
# here on every deny; weekly FP triage reads it (scripts/check-hook-fp-triage.sh).
export TQ_HOOK_DENY_LOG="$HOME/.cache/tq-hook-deny.log"
# >>> tq bootstrap (managed) >>>
permissions allow view ls grep glob edit multiedit write bash fetch download todos
option metrics false
model large zai/glm-5.3-flash --reasoning-effort xhigh
# <<< tq bootstrap (managed) <<<
