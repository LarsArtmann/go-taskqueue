package webui

import "github.com/larsartmann/templ-components/layout"

// Page is the full dashboard page (ADR-0003): a live read-only projection of
// the journal. Fragments are server-rendered into the #frag-* containers so
// the page works without JS; SSE then replaces innerHTML.
templ Page(data DashboardData) {
	@layout.Base(dashboardProps(ctx, pageTitle(data), ctxNonce(ctx))) {
		@pageHeader()
		<!-- The page owns its <main> (dashboardProps sets NoMainWrapper):
		     the topbar must stay OUTSIDE it to be the banner landmark, and
		     the library's skip link must land on the content. -->
		<main id="main-content" tabindex="-1" class="mx-auto w-full max-w-7xl flex-1 px-4 sm:px-6 lg:px-8">
			<section id="sec-overview" aria-labelledby="hd-overview" class="pt-6">
				<h2 id="hd-overview" class="sr-only">queue overview</h2>
				<div id="frag-stats">
					@StatusCards(data)
				</div>
			</section>
			<!-- L3 questions pane: empty (and invisible) until a `tq ask`
			     park exists; the SSE swap targets #frag-questions so an
			     answered question disappears live. -->
			<section id="sec-questions" aria-labelledby="hd-questions" class="pb-2 pt-6">
				<div id="frag-questions">
					@QuestionsPane(data)
				</div>
			</section>
			if data.Filter.View == viewBoard {
				<!-- Board view: the lanes are the instrument — the task section
				spans the full content width and the feed/DLQ flow below. -->
				<section id="sec-tasks" aria-labelledby="hd-tasks" class="space-y-3 pb-8 pt-8">
					<div class="flex items-center justify-between gap-4">
						@pageHeading("hd-tasks", "tasks", "")
						@viewToggle(data.Filter)
					</div>
					<div id="frag-filters">
						@FilterBar(data)
					</div>
					<div id="frag-table">
						@Board(data)
					</div>
				</section>
				<section id="sec-dlq" aria-labelledby="hd-dlq" class="space-y-3 pb-8">
					@pageHeading("hd-dlq", "dead-letter queue", "accent-danger")
					<div id="frag-dlq">
						@DeadLetterTable(data)
					</div>
				</section>
				<section id="sec-metrics" aria-labelledby="hd-metrics" class="space-y-3 pb-8">
					@pageHeading("hd-metrics", "activity", "")
					@MetricsRow(data)
				</section>
				<section id="sec-feed" aria-labelledby="hd-feed" class="min-w-0 space-y-3 pb-10">
					@pageHeading("hd-feed", "fact feed", "")
					<div id="frag-feed">
						@FactFeed(data)
					</div>
					@journalBrowser()
				</section>
			} else {
				<div class="grid gap-8 pb-10 pt-8 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
					<div class="min-w-0 space-y-8">
						<section id="sec-tasks" aria-labelledby="hd-tasks" class="space-y-3">
							<div class="flex items-center justify-between gap-4">
								@pageHeading("hd-tasks", "tasks", "")
								@viewToggle(data.Filter)
							</div>
							<div id="frag-filters">
								@FilterBar(data)
							</div>
							<div id="frag-table">
								if data.Filter.View == viewBoard {
									@Board(data)
								} else {
									@TaskTable(data)
								}
							</div>
						</section>
						<section id="sec-dlq" aria-labelledby="hd-dlq" class="space-y-3">
							@pageHeading("hd-dlq", "dead-letter queue", "accent-danger")
							<div id="frag-dlq">
								@DeadLetterTable(data)
							</div>
						</section>
						<!-- Trend charts sit BELOW the work surfaces: the first
						     screen belongs to the live queue, not to a flat
						     sparkline (2026-11-27 UX pass). -->
						<section id="sec-metrics" aria-labelledby="hd-metrics" class="space-y-3">
							@pageHeading("hd-metrics", "activity", "")
							@MetricsRow(data)
						</section>
					</div>
					<aside class="min-w-0">
						<section id="sec-feed" aria-labelledby="hd-feed" class="space-y-3 xl:sticky xl:top-20">
							@pageHeading("hd-feed", "fact feed", "")
							<div id="frag-feed">
								@FactFeed(data)
							</div>
							@journalBrowser()
						</section>
					</aside>
				</div>
			}
		</main>
		<!-- L2 live agent pane: hidden until app.js receives the first routed-run
		     event on /agents/live (the feed needs the serve crush-server flag
		     and routed runs); pure observability, never part of the task
		     projection, so it renders in no snapshot. -->
		<details id="agent-pane" class="mx-auto hidden w-full max-w-7xl px-4 pb-8 sm:px-6 lg:px-8" open>
			<summary class="tq-label cursor-pointer select-none">live agents</summary>
			<ul id="agent-feed" class="mt-3 space-y-1 font-mono text-xs" aria-live="polite"></ul>
		</details>
		<!-- The SSE client: the page renders fully without it, then app.js
		     swaps fragments in live (ADR-0003). Last in body so it never
		     blocks first paint; defer keeps execution after parsing. -->
		<script src="/static/app.js" defer></script>
	}
}

// TaskDetailPage is the per-task detail page.
templ TaskDetailPage(data DashboardData, detail taskDetailData) {
	@layout.Base(dashboardProps(ctx, detailPageTitle(detail.ID), ctxNonce(ctx))) {
		@pageHeader()
		<main id="main-content" tabindex="-1" class="flex-1">
			@TaskDetail(data, detail.Task, detail.Facts, detail.Provenance)
		</main>
	}
}

// TaskNotFoundPage is the styled 404 for /task/{id}: an unknown id keeps
// the dashboard chrome and a way back instead of a bare error page.
templ TaskNotFoundPage(id string) {
	@layout.Base(dashboardProps(ctx, detailPageTitle(id)+" — not found", ctxNonce(ctx))) {
		@pageHeader()
		<main id="main-content" tabindex="-1" class="flex-1">
			<div class="mx-auto w-full max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
				<div class="tq-heading">
					<h2 class="tq-label m-0">task not found</h2>
				</div>
				<p class="mt-4 break-all font-mono text-sm text-gray-600 dark:text-gray-300">{ id }</p>
				<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
					No task with this id exists in this journal — it was never enqueued here, or the dashboard is pointed at a different database.
				</p>
				<a
					class="tq-label mt-6 inline-block underline underline-offset-4 hover:text-blue-600 dark:hover:text-blue-400"
					href="/"
				>← back to dashboard</a>
			</div>
		</main>
	}
}

// pageHeader is the instrument chrome: a hull-dark bar in BOTH themes (the
// identity anchor — the light theme frames its content between this bar and
// the nowband), wordmark, connection lamp, theme toggle. The lamp's class
// (conn-live/conn-reconnecting/conn-stale) is driven by app.js over SSE
// heartbeats. The wordmark IS the page's <h1>: the only heading the library
// wrapper does not supply. The skip link belongs to layout.Base (it targets
// #main-content, which the page renders itself).
templ pageHeader() {
	<header class="tq-topbar sticky top-0 z-40">
		<div class="mx-auto flex h-14 w-full max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
			<h1 class="m-0 flex items-baseline gap-2 font-mono text-lg font-semibold text-gray-100">
				<a class="flex items-baseline gap-2" href="/">
					tq<span class="text-blue-400">·</span>
					<span class="hidden font-sans text-xs font-normal lowercase tracking-[0.14em] text-gray-400 sm:inline">taskqueue</span>
				</a>
			</h1>
			<span id="conn" class="conn conn-live ms-auto" role="status" aria-live="polite">live</span>
			@layout.ThemeToggle("Toggle color theme", ctxNonce(ctx))
		</div>
	</header>
}

// pageHeading is a ledger-style section heading with a hairline rule. The
// label is the quiet terminal convention (lowercase mono, tight tracking) —
// the loud all-caps eyebrow treatment reads templated (2026-09-16 design
// pass). It renders a real <h2> so the document outline (and screen-reader
// navigation) sees the sections the eye sees; id ties the owning <section>
// to its name via aria-labelledby. Accent rides a tq-* class because the
// unlayered theme rules outrank Tailwind color utilities.
templ pageHeading(id, text, accent string) {
	<div class="tq-heading">
		<h2 id={ id } class={ "tq-label m-0", accent }>{ text }</h2>
	</div>
}

// viewToggle switches the task projection: ledger table <-> board. Pure
// links — the view rides the URL like every other piece of view state, so
// it survives reloads, sharing, and SSE reconnects.
templ viewToggle(f FilterState) {
	<nav class="flex shrink-0 items-center gap-3 font-mono text-xs tracking-[0.08em]" aria-label="task view">
		@viewToggleLink(f, viewTable, "table", f.View == viewTable)
		@viewToggleLink(f, viewBoard, "board", f.View == viewBoard)
	</nav>
}

// viewToggleLink is one projection link; the active one carries
// aria-current="true" (templ can express a conditional attribute's
// PRESENCE, not its value — hence the branch).
templ viewToggleLink(f FilterState, view, label string, active bool) {
	if active {
		<a class={ viewToggleClass(true) } href={ templ.URL(viewToggleHref(f, view)) } aria-current="true">{ label }</a>
	} else {
		<a class={ viewToggleClass(false) } href={ templ.URL(viewToggleHref(f, view)) }>{ label }</a>
	}
}

// viewToggleClass styles one toggle link: the active projection is
// underlined ink, the other quiet gray that darkens on hover.
func viewToggleClass(active bool) string {
	if active {
		return "text-gray-900 underline underline-offset-4 dark:text-white"
	}

	return "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
}

// pageFooter carries the keyboard hints (wired via props.Footer so it sits
// outside the scrollable main region).
templ pageFooter() {
	<footer class="border-t border-gray-200 py-6 dark:border-gray-800">
		<div class="mx-auto flex w-full max-w-7xl flex-wrap items-center gap-x-5 gap-y-1 px-4 font-mono text-xs text-gray-500 dark:text-gray-400 sm:px-6 lg:px-8">
			<span>live projection of the journal</span>
			<span class="hidden items-center gap-1.5 sm:inline-flex">
				<kbd>/</kbd> search
				<kbd>1</kbd>-<kbd>4</kbd> sections
				<kbd>?</kbd> shortcuts
			</span>
		</div>
	</footer>
}
