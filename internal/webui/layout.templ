package webui

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/utils"
)

// Page is the full dashboard page (ADR-0003): a live read-only projection of
// the journal. Fragments are server-rendered into the #frag-* containers so
// the page works without JS; SSE then replaces innerHTML.
templ Page(data DashboardData) {
	@layout.Base(dashboardProps(pageTitle(data), ctxNonce(ctx))) {
		@pageHeader()
		<div class="mx-auto w-full max-w-7xl flex-1 px-4 sm:px-6 lg:px-8">
			<section id="sec-overview" class="pt-6">
				<div id="frag-stats">
					@StatusCards(data)
				</div>
			</section>
			@MetricsRow(data)
			<div class="grid gap-8 pb-10 pt-8 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
				<div class="min-w-0 space-y-8">
					<section id="sec-tasks" class="space-y-3">
						<div class="flex items-center justify-between gap-4">
							@pageHeading("tasks", "")
							@viewToggle(data.Filter)
						</div>
						<div id="frag-filters">
							@FilterBar(data)
						</div>
						<div id="frag-table">
							if data.Filter.View == viewBoard {
								@Board(data)
							} else {
								@TaskTable(data)
							}
						</div>
					</section>
					<section id="sec-dlq" class="space-y-3">
						@pageHeading("dead-letter queue", "text-red-600 dark:text-red-400")
						<div id="frag-dlq">
							@DeadLetterTable(data)
						</div>
					</section>
				</div>
				<aside class="min-w-0">
					<section id="sec-feed" class="space-y-3 xl:sticky xl:top-20">
						@pageHeading("fact feed", "")
						<div id="frag-feed">
							@FactFeed(data)
						</div>
						@journalBrowser()
					</section>
				</aside>
			</div>
		</div>
		<!-- The SSE client: the page renders fully without it, then app.js
		     swaps fragments in live (ADR-0003). Last in body so it never
		     blocks first paint; defer keeps execution after parsing. -->
		<script src="/static/app.js" defer></script>
	}
}

// TaskDetailPage is the per-task detail page.
templ TaskDetailPage(data DashboardData, detail taskDetailData) {
	@layout.Base(dashboardProps(detailPageTitle(detail.ID), ctxNonce(ctx))) {
		@pageHeader()
		@TaskDetail(data, detail.Task, detail.Facts)
	}
}

// TaskNotFoundPage is the styled 404 for /task/{id}: an unknown id keeps
// the dashboard chrome and a way back instead of a bare error page.
templ TaskNotFoundPage(id string) {
	@layout.Base(dashboardProps(detailPageTitle(id)+" — not found", ctxNonce(ctx))) {
		@pageHeader()
		<div class="mx-auto w-full max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
			<div class="tq-heading">
				@display.Eyebrow(display.EyebrowProps{Text: "task not found"})
			</div>
			<p class="mt-4 break-all font-mono text-sm text-gray-600 dark:text-gray-300">{ id }</p>
			<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
				No task with this id exists in this journal — it was never enqueued here, or the dashboard is pointed at a different database.
			</p>
			<a
				class="mt-6 inline-block font-mono text-xs uppercase tracking-[0.18em] text-gray-500 underline-offset-4 hover:text-blue-600 hover:underline dark:text-gray-400 dark:hover:text-blue-400"
				href="/"
			>← back to dashboard</a>
		</div>
	}
}

// pageHeader is the instrument chrome: wordmark, connection lamp, theme
// toggle. The lamp's class (conn-live/conn-reconnecting/conn-stale) is
// driven by app.js over SSE heartbeats.
templ pageHeader() {
	<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/85 backdrop-blur dark:border-gray-800 dark:bg-gray-950/85">
		<a href="#sec-overview" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-2 focus:z-50 focus:rounded-lg focus:bg-blue-600 focus:px-3 focus:py-1.5 focus:text-sm focus:text-white">skip to content</a>
		<div class="mx-auto flex h-14 w-full max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
			<a class="flex items-baseline gap-2 font-mono text-lg font-semibold text-gray-900 dark:text-white" href="/">
				tq<span class="text-blue-500 dark:text-blue-400">·</span>
				<span class="hidden font-sans text-xs font-normal uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500 sm:inline">taskqueue</span>
			</a>
			<span id="conn" class="conn conn-live ms-auto" role="status" aria-live="polite">live</span>
			@layout.ThemeToggle("Toggle color theme", ctxNonce(ctx))
		</div>
	</header>
}

// pageHeading is a ledger-style section overline with a hairline rule.
templ pageHeading(text, accent string) {
	<div class="tq-heading">
		@display.Eyebrow(display.EyebrowProps{BaseProps: utils.BaseProps{Class: accent}, Text: text})
	</div>
}

// viewToggle switches the task projection: ledger table <-> board. Pure
// links — the view rides the URL like every other piece of view state, so
// it survives reloads, sharing, and SSE reconnects.
templ viewToggle(f FilterState) {
	<nav class="flex shrink-0 items-center gap-3 font-mono text-xs uppercase tracking-[0.14em]" aria-label="task view">
		<a
			class={ viewToggleClass(f.View == viewTable) }
			href={ templ.URL(viewToggleHref(f, viewTable)) }
			aria-current={ templ.KV("true", f.View == viewTable) }
		>table</a>
		<a
			class={ viewToggleClass(f.View == viewBoard) }
			href={ templ.URL(viewToggleHref(f, viewBoard)) }
			aria-current={ templ.KV("true", f.View == viewBoard) }
		>board</a>
	</nav>
}

// viewToggleClass styles one toggle link: the active projection is
// underlined ink, the other quiet gray that darkens on hover.
func viewToggleClass(active bool) string {
	if active {
		return "text-gray-900 underline underline-offset-4 dark:text-white"
	}

	return "text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300"
}

// pageFooter carries the keyboard hints (wired via props.Footer so it sits
// outside the scrollable main region).
templ pageFooter() {
	<footer class="border-t border-gray-200 py-6 dark:border-gray-800">
		<div class="mx-auto w-full max-w-7xl px-4 font-mono text-xs text-gray-500 dark:text-gray-400 sm:px-6 lg:px-8">
			read-only projection of the journal · press <kbd>/</kbd> to search, <kbd>1</kbd>–<kbd>4</kbd> to jump
		</div>
	</footer>
}

// refreshMeta is a stall fallback: if SSE dies silently, reload hourly.
templ refreshMeta() {
	<meta http-equiv="refresh" content="3600"/>
}

// TaskNotFoundPage is the styled 404: the bare http.Error left the operator
// on a white void with no way back into the dashboard.
templ TaskNotFoundPage(id string) {
	@layout.Base(dashboardProps("task not found", ctxNonce(ctx))) {
		@pageHeader()
		<div class="mx-auto w-full max-w-2xl px-4 py-20">
			@display.EmptyState(display.EmptyStateProps{
				Title:       "task not found",
				Description: "No task with id " + id + " lives in this queue — ids are exact, not prefixes.",
				Icon:        icons.Inbox,
			})
			<p class="mt-8 text-center">
				<a
					class="font-mono text-sm text-blue-600 underline-offset-4 hover:underline dark:text-blue-400"
					href="/"
				>← back to the queue</a>
			</p>
		</div>
	}
}
