package webui

import (
	"github.com/larsartmann/go-taskqueue/internal/task"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/utils"
)

// The fragments are the SSE-swapped projections (ADR-0003): each is the
// inner content of its #frag-* container, re-rendered server-side on every
// journal burst. Visual language: templ-components components themed by
// internal/webui/theme.css.

// StatusCards renders the overview stat band (inner content of #frag-stats).
// The four active states carry tone icons and link to their filtered view;
// cancelled and total stay quiet (no icon). Marker classes (card-pending, …)
// are kept as stable hooks for tests and CSS.
templ StatusCards(data DashboardData) {
	@display.Grid(display.GridProps{Cols: display.GridCols6}) {
		@display.StatCard(display.StatCardProps{
			BaseProps: utils.BaseProps{Class: "card-pending"},
			Label:     "pending",
			Value:     formatInt(data.Counts[task.Pending]),
			Icon:      icons.Clock,
			Tone:      display.StatToneYellow,
			Href:      statusHref(task.Pending),
		})
		@display.StatCard(display.StatCardProps{
			BaseProps: utils.BaseProps{Class: "card-running"},
			Label:     "running",
			Value:     formatInt(data.Counts[task.Running]),
			Icon:      icons.Bolt,
			Tone:      display.StatToneBlue,
			Href:      statusHref(task.Running),
		})
		@display.StatCard(display.StatCardProps{
			BaseProps: utils.BaseProps{Class: "card-completed"},
			Label:     "completed",
			Value:     formatInt(data.Counts[task.Completed]),
			Icon:      icons.CheckCircle,
			Tone:      display.StatToneGreen,
			Href:      statusHref(task.Completed),
		})
		@display.StatCard(display.StatCardProps{
			BaseProps: utils.BaseProps{Class: "card-dead"},
			Label:     "dead",
			Value:     formatInt(data.Counts[task.Dead]),
			Icon:      icons.Fire,
			Tone:      display.StatToneRed,
			Href:      statusHref(task.Dead),
		})
		@display.StatCard(display.StatCardProps{
			BaseProps: utils.BaseProps{Class: "card-cancelled"},
			Label:     "cancelled",
			Value:     formatInt(data.Counts[task.Cancelled]),
			Href:      statusHref(task.Cancelled),
		})
		@display.StatCard(display.StatCardProps{
			BaseProps: utils.BaseProps{Class: "card-total"},
			Label:     "total",
			Value:     formatInt(data.Total),
		})
	}
	<div class="mt-4 flex flex-wrap items-center gap-2">
		if len(data.Projects) == 0 {
			<span class="font-mono text-xs uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500">no projects</span>
		} else {
			for _, p := range data.Projects {
				@display.Badge(display.BadgeProps{
					Text: p.Name + " " + formatInt(p.Running) + "R/" + formatInt(p.Pending) + "P/" + formatInt(p.Dead) + "D",
					Type: display.BadgeNeutral,
					Href: "?project=" + p.Name,
				})
			}
		}
	</div>
}

// TaskTable renders the live task table (inner content of #frag-table).
templ TaskTable(data DashboardData) {
	if len(data.Tasks) == 0 {
		if data.Filter.Empty() {
			@display.EmptyState(display.EmptyStateProps{
				Title:       "queue is empty",
				Description: "New tasks appear here live.",
				Icon:        icons.Inbox,
			})
		} else {
			@display.EmptyState(display.EmptyStateProps{
				Title:       "no tasks match the filter",
				Description: "Adjust or clear the filters above.",
				Icon:        icons.Filter,
			})
		}
	} else {
		@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
			@display.Table(display.TableProps{
				Caption:     "Live task queue",
				Headers:     []string{"id", "project", "type", "status", "attempts", "age", "last error"},
				Flush:       true,
				Hover:       true,
				CellPadding: display.TableCellPaddingCompact,
				Body:        taskRows(data),
			})
		}
	}
}

// taskRows renders the task table body. Hover styling is applied here
// because the library only adds it to Rows-driven tables, not Body slots.
templ taskRows(data DashboardData) {
	for _, t := range data.Tasks {
		<tr class={ taskRowClass(t) }>
			<td class={ tdCellClass(false) }>
				<a
					class="font-mono text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
					href={ templ.URL("/task/" + t.ID.String()) }
					title={ t.ID.String() }
				>{ shortID(t.ID) }</a>
			</td>
			<td class={ tdCellClass(true) }>{ t.Project }</td>
			<td class={ tdCellClass(false) }><span class="font-mono text-xs">{ t.Type }</span></td>
			<td class={ tdCellClass(true) }>
				@display.Badge(display.BadgeProps{Text: string(t.Status), Type: statusBadgeType(t.Status), Dot: true, Size: display.BadgeSizeSM})
			</td>
			<td class={ tdCellClass(false) }><span class="font-mono text-xs">{ formatInt(t.Attempts) }/{ formatInt(t.MaxAttempts) }</span></td>
			<td class={ tdCellClass(true) } title={ t.CreatedAt.Format(timeFormat) }>{ timeAgo(data.Now, t.CreatedAt) }</td>
			if t.LastError != "" {
				<td class={ tdCellClass(false) }>
					<span class="text-red-600 dark:text-red-400" title={ t.LastError }>{ truncate(t.LastError, errorPreviewLen) }</span>
				</td>
			} else {
				<td class={ tdCellClass(false) }></td>
			}
		</tr>
	}
}

// DeadLetterTable renders the dead-letter queue (inner content of
// #frag-dlq).
templ DeadLetterTable(data DashboardData) {
	if len(data.Dead) == 0 {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "dead-letter queue is empty",
			Description: "Tasks that exhaust their retries land here.",
			Icon:        icons.ArchiveBox,
		})
	} else {
		@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
			@display.Table(display.TableProps{
				Caption:     "Dead-letter queue",
				Headers:     []string{"id", "project", "type", "attempts", "last error"},
				Flush:       true,
				Hover:       true,
				CellPadding: display.TableCellPaddingCompact,
				Body:        deadRows(data),
			})
		}
	}
}

templ deadRows(data DashboardData) {
	for _, t := range data.Dead {
		<tr class={ taskRowClass(t) }>
			<td class={ tdCellClass(false) }>
				<a
					class="font-mono text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
					href={ templ.URL("/task/" + t.ID.String()) }
					title={ t.ID.String() }
				>{ shortID(t.ID) }</a>
			</td>
			<td class={ tdCellClass(true) }>{ t.Project }</td>
			<td class={ tdCellClass(false) }><span class="font-mono text-xs">{ t.Type }</span></td>
			<td class={ tdCellClass(false) }><span class="font-mono text-xs">{ formatInt(t.Attempts) }/{ formatInt(t.MaxAttempts) }</span></td>
			<td class={ tdCellClass(false) }>
				<span class="text-red-600 dark:text-red-400" title={ t.LastError }>{ truncate(t.LastError, errorPreviewLen) }</span>
			</td>
		</tr>
	}
}

// FactFeed renders the live fact tail (inner content of #frag-feed): the
// journal itself, terminal-style. Newest facts land at the bottom.
templ FactFeed(data DashboardData) {
	if len(data.Facts) == 0 {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "no facts yet",
			Description: "The journal is empty; facts land here the moment a task moves.",
			Icon:        icons.CircleStack,
		})
	} else {
		<div class="journal-scroll rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
			@display.Scrollback(display.ScrollbackProps{
				Stagger:   false,
				Lines:     factLines(data),
				BaseProps: utils.BaseProps{Class: "border-y-0"},
			})
		</div>
	}
}

// FilterBar renders the search/filter form (inner content of #frag-filters).
templ FilterBar(data DashboardData) {
	<form class="flex flex-wrap items-center gap-2" method="get" action="/">
		if data.Filter.Project != "" {
			@filterChip("project", data.Filter.Project, filterURL(data.Filter, clearProject))
		}
		if data.Filter.Status != "" {
			@filterChip("status", string(data.Filter.Status), filterURL(data.Filter, clearStatus))
		}
		if data.Filter.Query != "" {
			@filterChip("search", data.Filter.Query, filterURL(data.Filter, clearQuery))
		}
		<input
			type="search"
			id="search-box"
			name="q"
			placeholder="search type, payload, id, project…"
			value={ data.Filter.Query }
			class={ inputClass + " min-w-0 flex-1" }
		/>
		<select name="status" class={ inputClass + " font-mono text-xs" }>
			<option value="">status: all</option>
			for _, st := range allStatuses {
				<option value={ string(st) } selected?={ data.Filter.Status == st }>{ string(st) }</option>
			}
		</select>
		@display.Button(display.ButtonProps{
			Text:    "apply",
			Type:    display.ButtonHTMLSubmit,
			Variant: display.ButtonPrimary,
			Size:    display.ButtonSizeSM,
		})
		if data.Filter.Project != "" || data.Filter.Status != "" || data.Filter.Query != "" {
			<a class="font-mono text-xs uppercase tracking-[0.14em] text-gray-500 underline-offset-4 hover:text-blue-600 hover:underline dark:text-gray-400 dark:hover:text-blue-400" href="/">clear all</a>
		}
	</form>
}

// filterChip is one active filter with a remove link.
templ filterChip(kind, value, clearHref string) {
	<span class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-gray-50 px-2.5 py-1 font-mono text-xs text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
		<span class="uppercase tracking-widest text-gray-400 dark:text-gray-500">{ kind }</span>
		{ value }
		<a class="text-gray-400 hover:text-red-500 dark:text-gray-500 dark:hover:text-red-400" aria-label={ "clear " + kind + " filter" } href={ templ.URL(clearHref) }>×</a>
	</span>
}

// TaskDetail renders the per-task detail page body.
templ TaskDetail(data DashboardData, t task.Task, facts []journalFactView) {
	<div class="mx-auto w-full max-w-4xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
		<a
			class="font-mono text-xs uppercase tracking-[0.18em] text-gray-500 underline-offset-4 hover:text-blue-600 hover:underline dark:text-gray-400 dark:hover:text-blue-400"
			href="/"
		>← back to dashboard</a>
		<div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
			<h2 class="text-2xl font-semibold text-gray-900 dark:text-white">{ t.ID.String() }</h2>
			@display.Badge(display.BadgeProps{Text: string(t.Status), Type: statusBadgeType(t.Status), Dot: true})
		</div>
		if t.LastError != "" {
			@feedback.Alert(feedback.AlertProps{
				Type:    feedback.FeedbackError,
				Title:   "last error",
				Message: t.LastError,
			})
		}
		@display.Card(display.CardProps{Padding: display.CardPaddingLG}) {
			@display.DefinitionList(display.DefinitionListProps{Items: detailItems(t, data.Now)})
		}
		<div class="tq-heading">
			@display.Eyebrow(display.EyebrowProps{Text: "fact timeline"})
		</div>
		<div class="journal-scroll rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
			@display.Scrollback(display.ScrollbackProps{
				Stagger:   false,
				Lines:     detailFacts(data.Now, facts),
				BaseProps: utils.BaseProps{Class: "border-y-0"},
			})
		</div>
	</div>
}

// statusBadge is a shared dot badge for a status string.
templ statusBadge(s string, typ display.BadgeType) {
	@display.Badge(display.BadgeProps{Text: s, Type: typ, Dot: true})
}

// payloadCode renders a task payload as a breakable code block.
templ payloadCode(p string) {
	<code class="block break-all font-mono text-xs text-gray-700 dark:text-gray-300">{ p }</code>
}
