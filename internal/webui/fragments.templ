package webui

import (
	"fmt"
	"github.com/larsartmann/go-taskqueue/internal/executor"
	"github.com/larsartmann/go-taskqueue/internal/journal"
	"github.com/larsartmann/go-taskqueue/internal/task"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/utils"
)

// The fragments are the SSE-swapped projections (ADR-0003): each is the
// inner content of its #frag-* container, re-rendered server-side on every
// journal burst. Visual language: templ-components components themed by
// internal/webui/theme.css.

// StatusCards renders the overview stat band (inner content of #frag-stats).
// The four active states carry tone icons and link to their filtered view;
// cancelled and total stay quiet (no icon). Marker classes (card-pending, …)
// are kept as stable hooks for tests and CSS.
templ StatusCards(data DashboardData) {
	<div class="tq-nowband">
		<div class="tq-nowband-inner">
			<a class={ templ.Classes("tq-seg card-running", templ.KV("tq-seg-hot", data.Counts[task.Running] > 0)) } href={ templ.URL(statusHref(task.Running)) }>
				<span class="tq-seg-num">{ formatInt(data.Counts[task.Running]) }</span>
				<span class="tq-seg-label">running</span>
			</a>
			<a class="tq-seg card-pending" href={ templ.URL(statusHref(task.Pending)) }>
				<span class="tq-seg-num">{ formatInt(data.Counts[task.Pending]) }</span>
				<span class="tq-seg-label">pending</span>
			</a>
			<a class={ templ.Classes("tq-seg card-dead", templ.KV("tq-seg-alarm", data.Counts[task.Dead] > 0)) } href={ templ.URL(statusHref(task.Dead)) }>
				<span class="tq-seg-num">{ formatInt(data.Counts[task.Dead]) }</span>
				<span class="tq-seg-label">dead</span>
			</a>
			<a class="tq-seg card-completed" href={ templ.URL(statusHref(task.Completed)) }>
				<span class="tq-seg-num">{ formatInt(data.Counts[task.Completed]) }</span>
				<span class="tq-seg-label">completed</span>
			</a>
			<a class="tq-seg card-cancelled" href={ templ.URL(statusHref(task.Cancelled)) }>
				<span class="tq-seg-num">{ formatInt(data.Counts[task.Cancelled]) }</span>
				<span class="tq-seg-label">cancelled</span>
			</a>
		</div>
		<div class="tq-nowband-meta">
			<span class="card-total" title="all tasks ever">total { formatInt(data.Total) }</span>
			<span class="card-journal" title="journal watermark — highest fact seq">journal { formatInt(int(data.JournalSeq)) }</span>
			if data.Budget != nil {
				<span class="card-budget">budget today { formatInt(data.Budget.Spent) }/{ formatInt(data.Budget.Cap) }</span>
			}
		</div>
	</div>
	<div class="mt-3 flex flex-wrap items-center gap-1.5">
		if len(data.Projects) == 0 {
			<span class="font-mono text-xs uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500">no projects</span>
		} else {
			for _, p := range data.Projects {
				@display.Badge(display.BadgeProps{
					Text: p.Name + " " + formatInt(p.Running) + "R/" + formatInt(p.Pending) + "P/" + formatInt(p.Dead) + "D",
					Type: display.BadgeNeutral,
					Href: "?project=" + p.Name,
				})
			}
		}
	</div>
}

// TaskTable renders the live task table (inner content of #frag-table).
templ TaskTable(data DashboardData) {
	if len(data.Tasks) == 0 {
		if data.Filter.Empty() {
			@display.EmptyState(display.EmptyStateProps{
				Title:       "queue is empty",
				Description: "New tasks appear here live.",
				Icon:        icons.Inbox,
			})
		} else {
			@display.EmptyState(display.EmptyStateProps{
				Title:       "no tasks match the filter",
				Description: "Adjust or clear the filters above.",
				Icon:        icons.Filter,
			})
		}
	} else {
		@taskActiveCard(data)
		@taskSettledDetails(data)
		@taskPager(data)
	}
}

// taskActiveCard is the top half of the two-tier table: everything queued or
// running, always visible — the operator's answer to "what is happening
// right now?" never sits behind a collapse.
templ taskActiveCard(data DashboardData) {
	if len(activeTasks(data.Tasks)) > 0 {
		<div class="tq-kicker">active now</div>
		@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
			@display.Table(display.TableProps{
				Caption:      "Active tasks",
				TypedHeaders: taskHeaders(data),
				Flush:        true,
				Hover:        true,
				CellPadding:  display.TableCellPaddingCompact,
				Body:         taskRows(data, activeTasks(data.Tasks)),
			})
		}
	}
}

// taskSettledDetails folds completed/cancelled/dead rows behind a native
// <details> — no JS under CSP — so thirty identical completed rows stop
// drowning the live ones.
templ taskSettledDetails(data DashboardData) {
	if len(settledTasks(data.Tasks)) > 0 {
		<details class="tq-settled">
			<summary>
				<span class="tq-settled-title">settled</span>
				<span class="tq-settled-counts">
					{ formatInt(countStatus(data.Tasks, task.Completed)) } completed
					· { formatInt(countStatus(data.Tasks, task.Cancelled)) } cancelled
					{ settledDeadSuffix(data.Tasks) }
				</span>
			</summary>
			<div class="mt-2">
				@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
					@display.Table(display.TableProps{
						Caption:      "Settled tasks",
						TypedHeaders: taskHeaders(data),
						Flush:        true,
						Hover:        true,
						CellPadding:  display.TableCellPaddingCompact,
						Body:         taskRows(data, settledTasks(data.Tasks)),
					})
				}
			</div>
		</details>
	}
}

// taskPager renders prev/next pagination under the task table. It shows
// only when there is more than one page; the current page never links.
templ taskPager(data DashboardData) {
	if data.TotalPages > 1 {
		<nav class="flex items-center justify-between pt-3 text-xs text-gray-500 dark:text-gray-400" aria-label="Task table pages">
			<div>
				page { formatInt(data.Page) } of { formatInt(data.TotalPages) }
				<span class="pl-2 font-normal text-gray-400 dark:text-gray-500">{ formatInt(data.MatchTotal) } matching tasks</span>
			</div>
			<div class="flex gap-2">
				if data.Page > 1 {
					<a
						class="rounded-md border border-gray-200 px-2 py-1 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800"
						href={ templ.URL(pageHref(data.Filter, data.Page-1)) }
						rel="prev"
					>← prev</a>
				}
				if data.Page < data.TotalPages {
					<a
						class="rounded-md border border-gray-200 px-2 py-1 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800"
						href={ templ.URL(pageHref(data.Filter, data.Page+1)) }
						rel="next"
					>next →</a>
				}
			</div>
		</nav>
	}
}

// taskRows renders the task table body. Hover styling is applied here
// because the library only adds it to Rows-driven tables, not Body slots.
templ taskRows(data DashboardData, rows []task.Task) {
	for _, t := range rows {
		<tr class={ taskRowClass(t) }>
			<td class={ tdCellClass(false) }>
				<a
					class="font-mono text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
					href={ templ.URL("/task/" + t.ID.String()) }
					title={ t.ID.String() }
				>{ shortID(t.ID) }</a>
			</td>
			<td class={ tdCellClass(true) }>
				<a class="whitespace-nowrap hover:underline" href={ templ.URL("/project/" + t.Project) }>{ t.Project }</a>
			</td>
			<td class={ tdCellClass(false) }><span class="font-mono text-xs">{ t.Type }</span></td>
			</td>
			<td class={ tdCellClass(true) }>
				@display.Badge(display.BadgeProps{Text: string(t.Status), Type: statusBadgeType(t.Status), Dot: true, Size: display.BadgeSizeSM})
				if verdict, ok := data.Reviews[t.ID.String()]; ok {
					@display.Badge(display.BadgeProps{Text: verdictLabel(verdict.Verdict), Type: verdictBadgeType(verdict.Verdict), Dot: true, Size: display.BadgeSizeSM})
				}
				if st, ok := data.Statuses[t.ID.String()]; ok {
					@display.Badge(display.BadgeProps{Text: statusBadgeText(st), Type: display.BadgeInfo, Dot: true, Size: display.BadgeSizeSM})
				}
			</td>
			if data.AllowWrites {
				<td class={ tdCellClass(false) }>
					if t.Status == task.Pending {
						@cancelAction(t.ID, false)
					} else if t.Status == task.Running {
						@cancelAction(t.ID, true)
					} else if t.Status == task.Dead {
						@rescueAction(t.ID)
					}
				</td>
			}
			<td class={ tdCellClass(false) }><span class="font-mono text-xs">{ formatInt(t.Attempts) }/{ formatInt(t.MaxAttempts) }</span></td>
			if r := readiness(data.Now, t); r != "" {
				<td class={ tdCellClass(false) } title={ t.NotBefore.Format(timeFormat) }>
					<span class="font-mono text-xs text-gray-500 dark:text-gray-400">{ r }</span>
				</td>
			} else {
				<td class={ tdCellClass(false) }></td>
			}
			<td class={ tdCellClass(true) } title={ t.CreatedAt.Format(timeFormat) } data-age={ fmt.Sprintf("%d", t.CreatedAt.UnixMilli()) }>{ timeAgo(data.Now, t.CreatedAt) }</td>
			if t.LastError != "" {
				<td class={ tdCellClass(false) }>
					<span
						class="cursor-pointer text-red-600 dark:text-red-400"
						title={ t.LastError }
						data-error={ t.LastError }
						data-short={ truncate(t.LastError, errorPreviewLen) }
					>{ truncate(t.LastError, errorPreviewLen) }</span>
				</td>
			} else {
				<td class={ tdCellClass(false) }></td>
			}
		</tr>
	}
}

// cancelAction opens a reason form (native <details>, no JS under CSP).
// Pending tasks are withdrawn outright; running tasks get a cooperative
// stop REQUEST the agent honors between steps.
templ cancelAction(id task.ID, running bool) {
	<details class="tq-action">
		<summary>
			if running {
				<span class="tq-action-stop">stop</span>
			} else {
				<span class="tq-action-cancel">cancel</span>
			}
		</summary>
		<form class="tq-action-form" method="post" action={ templ.URL("/task/" + id.String() + "/cancel") }>
			<input type="hidden" name="csrf" value={ ctxCSRF(ctx) }/>
			<input type="text" name="reason" placeholder={ reasonPlaceholder(running) } maxlength="200"/>
			if running {
				<button type="submit">request stop</button>
			} else {
				<button type="submit">cancel task</button>
			}
		</form>
	</details>
}

// rescueAction re-queues a dead-lettered task with a fresh attempt budget.
templ rescueAction(id task.ID) {
	<details class="tq-action">
		<summary><span class="tq-action-rescue">rescue</span></summary>
		<form class="tq-action-form" method="post" action={ templ.URL("/task/" + id.String() + "/rescue") }>
			<input type="hidden" name="csrf" value={ ctxCSRF(ctx) }/>
			<select name="attempts">
				<option value="3" selected>3 attempts</option>
				<option value="1">1 attempt</option>
				<option value="5">5 attempts</option>
				<option value="10">10 attempts</option>
			</select>
			<button type="submit">re-queue</button>
		</form>
	</details>
}

// DeadLetterTable renders the dead-letter queue (inner content of
// #frag-dlq).
templ DeadLetterTable(data DashboardData) {
	if len(data.Dead) == 0 {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "dead-letter queue is empty",
			Description: "Tasks that exhaust their retries land here.",
			Icon:        icons.ArchiveBox,
		})
	} else {
		@display.Card(display.CardProps{Padding: display.CardPaddingNone}) {
			@display.Table(display.TableProps{
				Caption:     "Dead-letter queue",
				Headers:     []string{labelID, labelProject, labelType, labelAttempts, labelError},
				Flush:       true,
				Hover:       true,
				CellPadding: display.TableCellPaddingCompact,
				Body:        deadRows(data),
			})
		}
	}
}

templ deadRows(data DashboardData) {
	for _, t := range data.Dead {
		<tr class={ taskRowClass(t) }>
			<td class={ tdCellClass(false) }>
				<a
					class="font-mono text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
					href={ templ.URL("/task/" + t.ID.String()) }
					title={ t.ID.String() }
				>{ shortID(t.ID) }</a>
			</td>
			<td class={ tdCellClass(true) }>{ t.Project }</td>
			<td class={ tdCellClass(false) }><span class="font-mono text-xs">{ t.Type }</span></td>
			<td class={ tdCellClass(false) }><span class="font-mono text-xs">{ formatInt(t.Attempts) }/{ formatInt(t.MaxAttempts) }</span></td>
			<td class={ tdCellClass(false) }>
				<span class="text-red-600 dark:text-red-400" title={ t.LastError }>{ truncate(t.LastError, errorPreviewLen) }</span>
			</td>
		</tr>
	}
}

// FactFeed renders the live fact tail (inner content of #frag-feed): the
// journal itself, terminal-style. Newest facts land at the bottom. Each
// line's task id links to the detail page — a thin custom variant of the
// library Scrollback (which renders plain text lines only); the classes
// mirror its markup so the visual language stays one.
templ FactFeed(data DashboardData) {
	if len(data.Facts) == 0 {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "no facts yet",
			Description: "The journal is empty; facts land here the moment a task moves.",
			Icon:        icons.CircleStack,
		})
	} else {
		<div class="journal-scroll rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
			<div class="tc-log text-start border-y-0 py-3 font-mono text-[0.8125rem] leading-relaxed text-gray-600 dark:text-gray-400" aria-label="journal fact tail">
				for _, fact := range data.Facts {
					<div class={ templ.Classes("tc-log-line tc-log-line-still", templ.KV("tq-fact-cancelled", fact.Type == journal.Cancelled)) }>
						<span class="me-3 text-gray-400 dark:text-gray-500">{ factTimestamp(data.Now, fact.Time) }</span>
						<span class={ "me-2 inline-block min-w-12 font-medium " + factToneClass(factTone(fact.Type)) }>{ string(fact.Type) }</span>
						<a
							class="text-blue-600 hover:underline dark:text-blue-400"
							href={ templ.URL("/task/" + fact.TaskID) }
							title={ fact.TaskID }
						>{ shortIDTail(fact.TaskID) }</a>
						if fact.Error != "" {
							<span class="text-red-600 dark:text-red-400">{ truncate(fact.Error, errorPreviewLen) }</span>
						}
					</div>
				}
			</div>
		</div>
	}
}

// Board renders the kanban projection (inner content of #frag-table when
// the filter selects the board): one column per lifecycle status — the
// queue's state machine made visible, cards newest first. Columns are
// read-only projections, not drag-and-drop lanes: moving a card is queue
// mutation and waits for the --allow-writes gate (ADR-0003 Phase D).
templ Board(data DashboardData) {
	if data.MatchTotal == 0 {
		if data.Filter.Empty() {
			@display.EmptyState(display.EmptyStateProps{
				Title:       "queue is empty",
				Description: "New tasks appear here live.",
				Icon:        icons.Inbox,
			})
		} else {
			@display.EmptyState(display.EmptyStateProps{
				Title:       "no tasks match the filter",
				Description: "Adjust or clear the filters above.",
				Icon:        icons.Filter,
			})
		}
	} else {
		<div class="board overflow-x-auto pb-2">
			<ol class="flex min-w-max items-start gap-4" aria-label="tasks by lifecycle status">
				for _, col := range data.Board {
					@boardColumn(data, col)
				}
			</ol>
		</div>
	}
}

// boardColumn is one lifecycle lane: the status-colored top rule, the true
// count, the newest cards, and an honest "+N older" escape hatch into the
// status-filtered table view when the column is truncated.
templ boardColumn(data DashboardData, col BoardColumn) {
	<li class="w-64 shrink-0" data-status={ string(col.Status) } aria-label={ string(col.Status) + " column" }>
		<div class={ "border-t-2 pt-2 " + statusAccentClass(col.Status) }>
			<div class="flex items-baseline justify-between gap-2">
				<span class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-gray-700 dark:text-gray-300">{ string(col.Status) }</span>
				<span class="font-mono text-xs text-gray-400 dark:text-gray-500">{ formatInt(col.Count) }</span>
			</div>
		</div>
		<ul class="mt-3 space-y-2">
			if len(col.Tasks) == 0 {
				<li class="rounded-lg border border-dashed border-gray-200 px-3 py-4 text-center font-mono text-xs text-gray-400 dark:border-gray-800 dark:text-gray-500">empty</li>
			} else {
				for _, t := range col.Tasks {
					@boardCard(data, t)
				}
			}
		</ul>
		if col.Truncated > 0 {
			<a
				class="mt-2 inline-block font-mono text-xs text-blue-600 underline-offset-4 hover:underline dark:text-blue-400"
				href={ templ.URL(filterHref(FilterState{Status: col.Status, Project: data.Filter.Project, Query: data.Filter.Query})) }
			>{ "+" + formatInt(col.Truncated) + " older →" }</a>
		}
	</li>
}

// boardCard is one task on the board: id + live age, project + type, and
// the status-relevant detail — readiness countdown while pending, lease
// owner while running, attempts + error tail once dead.
templ boardCard(data DashboardData, t task.Task) {
	<li class="rounded-lg border border-gray-200 bg-white p-2.5 hover:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:hover:bg-gray-800/60">
		<div class="flex items-baseline justify-between gap-2">
			<a
				class="font-mono text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
				href={ templ.URL("/task/" + t.ID.String()) }
				title={ t.ID.String() }
			>{ shortID(t.ID) }</a>
			<span class="font-mono text-xs text-gray-400 dark:text-gray-500" data-age={ fmt.Sprintf("%d", t.CreatedAt.UnixMilli()) } title={ t.CreatedAt.Format(timeFormat) }>{ timeAgo(data.Now, t.CreatedAt) }</span>
		</div>
		<div class="mt-1 flex items-baseline gap-2 font-mono text-xs">
			<a class="truncate text-gray-700 hover:underline dark:text-gray-300" href={ templ.URL("/project/" + t.Project) }>{ t.Project }</a>
			<span class="shrink-0 text-gray-400 dark:text-gray-500">{ t.Type }</span>
		</div>
		if r := readiness(data.Now, t); r != "" {
			<div class="mt-1 font-mono text-xs text-gray-500 dark:text-gray-400">{ r }</div>
		}
		if t.Status == task.Running && t.LeaseOwner != "" {
			<div class="mt-1 truncate font-mono text-xs text-gray-500 dark:text-gray-400" title={ t.LeaseOwner }>{ t.LeaseOwner }</div>
		}
		if t.Status == task.Dead {
			<div class="mt-1 flex items-baseline gap-2 font-mono text-xs">
				<span class="shrink-0 text-red-600 dark:text-red-400">{ formatInt(t.Attempts) }/{ formatInt(t.MaxAttempts) }</span>
				if t.LastError != "" {
					<span class="truncate text-red-600/80 dark:text-red-400/80" title={ t.LastError }>{ truncate(t.LastError, errorPreviewLen) }</span>
				}
			</div>
		}
	</li>
}

// FilterBar renders the search/filter form (inner content of #frag-filters).
templ FilterBar(data DashboardData) {
	<form class="flex flex-wrap items-center gap-2" method="get" action="/">
		if data.Filter.View == viewBoard {
			<input type="hidden" name="view" value={ viewBoard }/>
		}
		if data.Filter.Project != "" {
			@filterChip("project", data.Filter.Project, filterURL(data.Filter, clearProject))
		}
		if data.Filter.Status != "" {
			@filterChip("status", string(data.Filter.Status), filterURL(data.Filter, clearStatus))
		}
		if data.Filter.Query != "" {
			@filterChip("search", data.Filter.Query, filterURL(data.Filter, clearQuery))
		}
		<input
			type="search"
			id="search-box"
			name="q"
			placeholder="search type, payload, id, project…"
			value={ data.Filter.Query }
			class={ inputClass + " min-w-0 flex-1" }
		/>
		if data.Filter.View != viewBoard {
			<select name="status" class={ inputClass + " font-mono text-xs" }>
				<option value="">status: all</option>
				for _, st := range allStatuses {
					<option value={ string(st) } selected?={ data.Filter.Status == st }>{ string(st) }</option>
				}
			</select>
		}
		@display.Button(display.ButtonProps{
			Text:    "apply",
			Type:    display.ButtonHTMLSubmit,
			Variant: display.ButtonPrimary,
			Size:    display.ButtonSizeSM,
		})
		if data.Filter.Project != "" || data.Filter.Status != "" || data.Filter.Query != "" {
			<a class="font-mono text-xs uppercase tracking-[0.14em] text-gray-500 underline-offset-4 hover:text-blue-600 hover:underline dark:text-gray-400 dark:hover:text-blue-400" href="/">clear all</a>
		}
	</form>
}

// filterChip is one active filter with a remove link.
templ filterChip(kind, value, clearHref string) {
	<span class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-gray-50 px-2.5 py-1 font-mono text-xs text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
		<span class="uppercase tracking-widest text-gray-400 dark:text-gray-500">{ kind }</span>
		{ value }
		<a class="text-gray-400 hover:text-red-500 dark:text-gray-500 dark:hover:text-red-400" aria-label={ "clear " + kind + " filter" } href={ templ.URL(clearHref) }>×</a>
	</span>
}

// TaskDetail renders the per-task detail page body. The two live regions sit
// in #frag-detail / #frag-timeline containers so the /task/{id}/events
// stream can swap them over SSE exactly like the dashboard fragments.
templ TaskDetail(data DashboardData, t task.Task, facts []journalFactView) {
	<div class="mx-auto w-full max-w-4xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
		<a
			class="font-mono text-xs uppercase tracking-[0.18em] text-gray-500 underline-offset-4 hover:text-blue-600 hover:underline dark:text-gray-400 dark:hover:text-blue-400"
			href="/"
		>← back to dashboard</a>
		<div id="frag-detail">
			@taskDetailCard(data, t)
		</div>
		<div class="tq-heading">
			@display.Eyebrow(display.EyebrowProps{Text: "fact timeline"})
		</div>
		<div id="frag-timeline">
			@taskDetailTimeline(data, facts)
		</div>
	</div>
}

// taskDetailCard is the task's live summary: id, status, last error, and
// the full record definition list (inner content of #frag-detail).
templ taskDetailCard(data DashboardData, t task.Task) {
	<div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
		<h2 class="text-2xl font-semibold text-gray-900 dark:text-white">{ t.ID.String() }</h2>
		@display.Badge(display.BadgeProps{Text: string(t.Status), Type: statusBadgeType(t.Status), Dot: true})
		if verdict, ok := data.Reviews[t.ID.String()]; ok {
			@display.Badge(display.BadgeProps{Text: verdictLabel(verdict.Verdict), Type: verdictBadgeType(verdict.Verdict), Dot: true})
		}
		if st, ok := data.Statuses[t.ID.String()]; ok {
			@display.Badge(display.BadgeProps{Text: statusBadgeText(st), Type: display.BadgeInfo, Dot: true})
		}
	</div>
	if data.AllowWrites {
		<div class="tq-actions">
			if t.Status == task.Pending {
				@cancelAction(t.ID, false)
			} else if t.Status == task.Running {
				@cancelAction(t.ID, true)
			} else if t.Status == task.Dead {
				@rescueAction(t.ID)
			}
		</div>
	}
	if t.LastError != "" {
		@feedback.Alert(feedback.AlertProps{
			Type:    feedback.FeedbackError,
			Title:   "last error",
			Message: t.LastError,
		})
	}
	if verdict, ok := data.Reviews[t.ID.String()]; ok {
		@reviewFindings(verdict)
	}
	if st, ok := data.Statuses[t.ID.String()]; ok {
		@statusReportCard(st)
	}
	@display.Card(display.CardProps{Padding: display.CardPaddingLG}) {
		@display.DefinitionList(display.DefinitionListProps{Items: detailItems(t, data.Now)})
	}
}

// reviewFindings renders the review loop's verdict: the reviewer's summary
// plus each finding with its severity — the operator's answer to "what did
// the reviewer think of this change?".
templ reviewFindings(res executor.ReviewResult) {
	@display.Card(display.CardProps{Title: "agent review", Padding: display.CardPaddingMD}) {
		if res.Summary != "" {
			<p class="text-sm text-gray-600 dark:text-gray-300">{ res.Summary }</p>
		}
		if len(res.Findings) == 0 {
			<p class="text-sm text-gray-500 dark:text-gray-400">no findings recorded</p>
		} else {
			<ul class="space-y-2">
				for _, finding := range res.Findings {
					<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
						if finding.Severity != "" {
							@display.Badge(display.BadgeProps{Text: finding.Severity, Type: findingSeverityType(finding.Severity), Size: display.BadgeSizeSM})
						}
						<span class="text-sm font-medium text-gray-900 dark:text-white">{ finding.Title }</span>
						if finding.Detail != "" {
							<span class="text-xs text-gray-500 dark:text-gray-400">{ finding.Detail }</span>
						}
					</li>
				}
			</ul>
		}
	}
}

// statusReportCard renders the status loop's outcome: where the report
// landed and how much fresh work it minted. The path is copyable code, not a
// link — `tq serve` is a read-only queue projection and never serves repo
// files (ADR-0003).
templ statusReportCard(res executor.StatusResult) {
	@display.Card(display.CardProps{Title: "status report", Padding: display.CardPaddingMD}) {
		<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
			@display.Badge(display.BadgeProps{Text: fmt.Sprintf("%d next items", res.NextItems), Type: display.BadgeInfo, Size: display.BadgeSizeSM})
			<code class="break-all font-mono text-xs text-gray-700 dark:text-gray-300">{ res.Report }</code>
		</div>
		if res.LogPath != "" {
			<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">full agent output: <code class="break-all font-mono text-xs">{ res.LogPath }</code></p>
		}
	}
}

// taskDetailTimeline is the task's live fact trail, newest last (inner
// content of #frag-timeline).
templ taskDetailTimeline(data DashboardData, facts []journalFactView) {
	if len(facts) == 0 {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "no facts yet",
			Description: "This task has not moved; facts land here live.",
			Icon:        icons.CircleStack,
		})
	} else {
		<div class="journal-scroll rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
			@display.Scrollback(display.ScrollbackProps{
				Stagger:   false,
				Lines:     detailFacts(data.Now, facts),
				BaseProps: utils.BaseProps{Class: "border-y-0"},
			})
		</div>
	}
}

// statusBadge is a shared dot badge for a status string.
templ statusBadge(s string, typ display.BadgeType) {
	@display.Badge(display.BadgeProps{Text: s, Type: typ, Dot: true})
}

// payloadCode renders a task payload as a breakable code block.
templ payloadCode(p string) {
	<code class="block break-all font-mono text-xs text-gray-700 dark:text-gray-300">{ p }</code>
}

// MetricsRow renders the overview's two pure-SVG charts (M19): the fact
// rate sparkline (facts per 5-minute slice of the last hour) and the
// completion histogram (time-to-complete: queue wait + run, honestly
// labeled). Both are server-rendered SVG — no JavaScript, CSP-safe.
templ MetricsRow(data DashboardData) {
	<div class="grid gap-4 pb-2 pt-4 md:grid-cols-2" id="frag-metrics">
		@display.Card(display.CardProps{Title: "fact rate (last hour, per 5m)"}) {
			<div class="px-2 pb-2">
				@display.AreaChart(display.AreaChartProps{
					Series:      []display.LineChartSeries{{Name: "facts", Values: data.FactBuckets, Color: "text-cyan-600 dark:text-cyan-400"}},
					Height:      120,
					ShowGrid:    false,
					FillOpacity: 0.25,
					Width:       560,
				})
			</div>
		}
		@display.Card(display.CardProps{Title: "time to complete (queue + run)"}) {
			<div class="px-2 pb-2">
				if len(data.CompleteMinutes) == 0 {
					<p class="px-2 py-6 text-sm text-gray-500 dark:text-gray-400">no completed tasks yet</p>
				} else {
					@display.AreaChart(display.AreaChartProps{
						Series:      []display.LineChartSeries{{Name: "tasks", Values: completeHistogram(data), Color: "text-emerald-600 dark:text-emerald-400"}},
						XAxisLabels: completeHistogramLabels(data),
						Height:      120,
						ShowGrid:    false,
						FillOpacity: 0.25,
						Width:       560,
					})
				}
			</div>
		}
	</div>
}

// journalBrowser is the no-JS entry to the full-journal viewer: the feed
// above shows the tail, this collapsible pages forward through history via
// GET /api/facts?after= (app.js powers the infinite scroll).
templ journalBrowser() {
	<details id="journal-browser" class="pt-2">
		<summary class="cursor-pointer select-none text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">browse the full journal (oldest first)</summary>
		<div id="journal-browser-rows" class="mt-2 font-mono text-xs"></div>
		<button id="journal-browser-more" type="button" class="mt-2 rounded-lg border border-gray-300 px-3 py-1 text-xs dark:border-gray-700" hidden>load older</button>
	</details>
}
