[Unit]
Description=tq agent-pool (self-managing TODO_LIST harvest + headless agents)
Documentation=https://github.com/LarsArtmann/go-taskqueue
After=network-online.target
Wants=network-online.target

[Service]
# Replace with the deployed binary path; keep flags out of the unit and
# pin them in a config file instead (see --config):
#   ExecStart=%h/go/bin/tq agent-pool --config %h/.config/tq/pool.conf
# Recommended config keys for unattended operation (pool.conf):
#   status-every = 20        # one status report per 20 agent completions
#                            # per project (0 = off; each report can append
#                            # follow-up TODO items — budget caps it)
#   daily-budget = 15        # hard enqueue cap per calendar day
#   dead-pool-ticks = 3      # PapDashboard alert when EVERY repo scan-fails
#                            # this many consecutive harvest ticks (0 = off)
#   review = true
#   review-autofix = true
ExecStart=%h/go/bin/tq agent-pool
Restart=on-failure
RestartSec=30s

# Graceful drain: agents may run for a long time; give them a wide stop
# window. The pool survives the first SIGTERM and finishes in-flight tasks.
TimeoutStopSec=45min
KillSignal=SIGINT
KillMode=process

# Hardening. Deliberately conservative: the pool execs headless agents that
# write/commit inside ~/projects and talk to the network, so no sandboxing
# below may break either. NoNewPrivileges and the kernel/cgroup namespaces
# cost nothing; ProtectSystem=full keeps /usr,/boot,/etc read-only while
# leaving $HOME writable for the repos and the binary.
NoNewPrivileges=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target

# Install (user session, no root):
#   mkdir -p ~/.config/systemd/user && cp deploy/systemd/tq-agent-pool.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now tq-agent-pool.service
#   journalctl --user -u tq-agent-pool -f
# Reboot survival: run `loginctl enable-linger $USER` once so the unit
# starts at boot without an active login session.
